# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_TRANSPORT=polling          # polling (dev) | webhook (prod)
TELEGRAM_WEBHOOK_SECRET=            # só em produção

# Ollama — cloud ou local (ADR 0002)
OLLAMA_HOST=https://ollama.com      # local: http://localhost:11434
OLLAMA_API_KEY=                     # vazio quando local
OLLAMA_MODEL=

# Banco
DATABASE_URL=postgres://noto:noto@localhost:5432/noto?sslmode=disable

# Aplicação
LOG_LEVEL=info
DEFAULT_TIMEZONE=America/Sao_Paulo
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
