# Telegram
# obrigatório: o serve, o worker e o migrate recusam iniciar sem ele; obtenha com o @BotFather
TELEGRAM_BOT_TOKEN=
# polling (dev) | webhook (prod)
TELEGRAM_TRANSPORT=polling
# só em produção
TELEGRAM_WEBHOOK_SECRET=

# Ollama — cloud ou local (ADR 0002)
# local: http://localhost:11434
OLLAMA_HOST=https://ollama.com
# vazio quando local
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-v4-flash:0731

# Banco
DATABASE_URL=postgres://noto:noto@localhost:5432/noto?sslmode=disable

# Aplicação
LOG_LEVEL=info
DEFAULT_TIMEZONE=America/Sao_Paulo
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
